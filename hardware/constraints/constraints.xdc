create_clock -period 20.000 [get_ports clk]

set_property PACKAGE_PIN N18 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]

set_property PACKAGE_PIN P16 [get_ports rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports rst_n]

# HDMI
set_property PACKAGE_PIN U18 [get_ports hdmi_tx_clk_p]
set_property PACKAGE_PIN N20 [get_ports {hdmi_tx_chn_b_p}]
set_property PACKAGE_PIN T20 [get_ports {hdmi_tx_chn_g_p}]
set_property PACKAGE_PIN V20 [get_ports {hdmi_tx_chn_r_p}]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_tx_chn_r_p]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_tx_chn_g_p]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_tx_chn_b_p]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_tx_clk_p]

# Segment pins 
set_property PACKAGE_PIN P18 [get_ports segment_0]
set_property PACKAGE_PIN R17 [get_ports segment_1]
set_property PACKAGE_PIN U17 [get_ports segment_2]
set_property PACKAGE_PIN W19 [get_ports segment_3]
set_property PACKAGE_PIN Y19 [get_ports segment_4]
set_property PACKAGE_PIN Y17 [get_ports segment_5]
set_property PACKAGE_PIN V18 [get_ports segment_6]
set_property IOSTANDARD LVCMOS33 [get_ports segment_0]
set_property IOSTANDARD LVCMOS33 [get_ports segment_1]
set_property IOSTANDARD LVCMOS33 [get_ports segment_2]
set_property IOSTANDARD LVCMOS33 [get_ports segment_3]
set_property IOSTANDARD LVCMOS33 [get_ports segment_4]
set_property IOSTANDARD LVCMOS33 [get_ports segment_5]
set_property IOSTANDARD LVCMOS33 [get_ports segment_6]

# Digit pins 
set_property PACKAGE_PIN Y14 [get_ports digit_0]
set_property PACKAGE_PIN W16 [get_ports digit_1]
set_property PACKAGE_PIN R18 [get_ports digit_2]
set_property PACKAGE_PIN W13 [get_ports digit_3]
set_property PACKAGE_PIN T15 [get_ports digit_4]
set_property PACKAGE_PIN T10 [get_ports digit_5]
set_property PACKAGE_PIN W15 [get_ports digit_6]
set_property PACKAGE_PIN R14 [get_ports digit_7]
set_property PACKAGE_PIN U15 [get_ports digit_8]
set_property PACKAGE_PIN V13 [get_ports digit_9]
set_property PACKAGE_PIN U12 [get_ports digit_10]
set_property IOSTANDARD LVCMOS33 [get_ports digit_0]
set_property IOSTANDARD LVCMOS33 [get_ports digit_1]
set_property IOSTANDARD LVCMOS33 [get_ports digit_2]
set_property IOSTANDARD LVCMOS33 [get_ports digit_3]
set_property IOSTANDARD LVCMOS33 [get_ports digit_4]
set_property IOSTANDARD LVCMOS33 [get_ports digit_5]
set_property IOSTANDARD LVCMOS33 [get_ports digit_6]
set_property IOSTANDARD LVCMOS33 [get_ports digit_7]
set_property IOSTANDARD LVCMOS33 [get_ports digit_8]
set_property IOSTANDARD LVCMOS33 [get_ports digit_9]
set_property IOSTANDARD LVCMOS33 [get_ports digit_10]

# Next piece pins 
set_property PACKAGE_PIN W14 [get_ports next_piece_led_0]
set_property PACKAGE_PIN V17 [get_ports next_piece_led_1]
set_property PACKAGE_PIN Y16 [get_ports next_piece_led_2]
set_property PACKAGE_PIN Y18 [get_ports next_piece_led_3]
set_property PACKAGE_PIN W18 [get_ports next_piece_led_4]
set_property PACKAGE_PIN T16 [get_ports next_piece_led_5]
set_property PACKAGE_PIN R16 [get_ports next_piece_led_6]
set_property PACKAGE_PIN N17 [get_ports next_piece_led_7]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_0]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_1]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_2]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_3]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_4]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_5]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_6]
set_property IOSTANDARD LVCMOS33 [get_ports next_piece_led_7]

# Game state pins
set_property PACKAGE_PIN T12 [get_ports game_state_0]
set_property PACKAGE_PIN U13 [get_ports game_state_1]
set_property PACKAGE_PIN U14 [get_ports game_state_2]
set_property PACKAGE_PIN P14 [get_ports game_state_3]
set_property IOSTANDARD LVCMOS33 [get_ports game_state_0]
set_property IOSTANDARD LVCMOS33 [get_ports game_state_1]
set_property IOSTANDARD LVCMOS33 [get_ports game_state_2]
set_property IOSTANDARD LVCMOS33 [get_ports game_state_3]

# Buttons
set_property PACKAGE_PIN V16 [get_ports button_start]
set_property PACKAGE_PIN T17 [get_ports button_rotate_cw]
set_property PACKAGE_PIN V12 [get_ports button_rotate_ccw]
set_property PACKAGE_PIN T14 [get_ports button_right]
set_property PACKAGE_PIN T11 [get_ports button_down]
set_property PACKAGE_PIN V15 [get_ports button_left]
set_property IOSTANDARD LVCMOS33 [get_ports button_start]
set_property IOSTANDARD LVCMOS33 [get_ports button_rotate_cw]
set_property IOSTANDARD LVCMOS33 [get_ports button_rotate_ccw]
set_property IOSTANDARD LVCMOS33 [get_ports button_right]
set_property IOSTANDARD LVCMOS33 [get_ports button_down]
set_property IOSTANDARD LVCMOS33 [get_ports button_left]
set_property PULLTYPE PULLDOWN [get_ports button_start]
set_property PULLTYPE PULLDOWN [get_ports button_rotate_cw]
set_property PULLTYPE PULLDOWN [get_ports button_rotate_ccw]
set_property PULLTYPE PULLDOWN [get_ports button_right]
set_property PULLTYPE PULLDOWN [get_ports button_down]
set_property PULLTYPE PULLDOWN [get_ports button_left]
